# Copy to .env; never commit .env or real API keys
NEXUSFORGE_ACCESS_TOKEN=replace-with-long-unique-random-secret
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# Optional local self-hosted model. This localhost URL works when running Go on host.
# For Docker, configure reachable HTTPS endpoint or use host-network-specific setup.
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.2
